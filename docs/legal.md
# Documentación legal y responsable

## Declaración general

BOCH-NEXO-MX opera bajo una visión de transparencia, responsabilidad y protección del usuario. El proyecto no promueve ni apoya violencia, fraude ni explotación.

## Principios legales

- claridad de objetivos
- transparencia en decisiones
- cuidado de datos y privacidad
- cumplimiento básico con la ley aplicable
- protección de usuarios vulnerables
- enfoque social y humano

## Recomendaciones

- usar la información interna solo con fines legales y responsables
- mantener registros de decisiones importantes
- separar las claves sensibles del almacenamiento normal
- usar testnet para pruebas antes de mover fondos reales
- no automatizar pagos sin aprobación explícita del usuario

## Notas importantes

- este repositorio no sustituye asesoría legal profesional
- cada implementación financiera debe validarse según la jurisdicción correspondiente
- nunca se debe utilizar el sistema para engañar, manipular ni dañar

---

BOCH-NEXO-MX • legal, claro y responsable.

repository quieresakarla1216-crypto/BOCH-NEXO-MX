from __future__ import annotations

import os
from typing import Any, Dict

import requests


def get_price(asset: str = "bitcoin", fiat: str = "mxn") -> Dict[str, Any]:
    url = f"https://api.coingecko.com/api/v3/simple/price?ids={asset}&vs_currencies={fiat}"
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        return response.json()
    except Exception as exc:
        return {"error": str(exc)}


def get_eth_gas() -> Dict[str, Any]:
    api_key = os.getenv("ETHERSCAN_API_KEY")
    if not api_key:
        return {"error": "Falta ETHERSCAN_API_KEY"}
    url = f"https://api.etherscan.io/api?module=gastracker&action=gasoracle&apikey={api_key}"
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
        return response.json()
    except Exception as exc:
        return {"error": str(exc)}


def get_mempool_fees() -> Dict[str, Any]:
    try:
        response = requests.get("https://mempool.space/api/v1/fees/recommended", timeout=15)
        response.raise_for_status()
        return response.json()
    except Exception as exc:
        return {"error": str(exc)}


__all__ = ["get_price", "get_eth_gas", "get_mempool_fees"]
